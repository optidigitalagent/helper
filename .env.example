# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key

# --- LLM provider: "openai" (default) or "claude"
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (used when LLM_PROVIDER=claude) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-3-5-haiku-20241022

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# --- Scheduler ---
DIGEST_CRON=30 7 * * *
LOOKBACK_HOURS=24

# --- Optional: self-hosted RSSHub ---
RSSHUB_BASE_URL=http://localhost:1200

# --- Mock mode ---
USE_MOCK_SOURCE=false

# --- Server ---
PORT=3000

# --- Reminder Bot (personal tasks) ---
# Separate Telegram bot token — get from @BotFather
REMINDER_BOT_TOKEN=your-reminder-bot-token
# Optional: restrict which chat can add reminders shown in digest
REMINDER_DEFAULT_CHAT_ID=
# Timezone for due dates and digest block
REMINDER_DEFAULT_TIMEZONE=Europe/Kyiv
# Whisper model for voice transcription
REMINDER_AUDIO_TRANSCRIPTION_MODEL=whisper-1

# --- Distribution Bot (digest broadcast to whitelist) ---
# Separate bot token for broadcasting the daily digest to subscribers
# Create via @BotFather. Leave empty to disable distribution.
TELEGRAM_DISTRIBUTION_BOT_TOKEN=
# Comma-separated list of Telegram User IDs allowed to receive the digest.
# Seeded into data/allowed_users.json on first run.
# Use /distrib add <id> in the reminder bot to manage the list at runtime.
ALLOWED_USER_IDS=
